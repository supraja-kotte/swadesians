# Copy this file to .env and fill in real values when the integration is built.
# Never commit the real .env file.

AGRIGUIDE_MODE=development
AGRIGUIDE_VERSION=1.0.0-demo
# production enables Secure cookies and requires HTTPS

# Database URL. SQLite by default; can be changed to PostgreSQL later.
DATABASE_URL=sqlite:///./agri_guide.db

# Comma-separated origins allowed to call the API from a separate frontend server.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Community photos/videos are stored on this server only. Mount a persistent
# volume here in production; this folder is not committed to git.
# UPLOAD_DIR=/absolute/path/to/uploads

# External services (empty means demo mode)
WEATHER_PROVIDER=open-meteo
YOUTUBE_API_KEY=

# Natural-language voice assistant. Never put this key in frontend code.
# Provider: openai (default, OpenAI-compatible) or gemini
AI_PROVIDER=openai
AI_API_KEY=
# Optional. Defaults: gpt-4o-mini for openai, gemini-2.0-flash for gemini.
AI_MODEL=
# Optional override for an OpenAI-compatible service.
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=20

# Optional: export these in your shell only when running the non-interactive
# admin setup command. They are not read from this file automatically.
# Leave empty in normal use. Choose a unique password of at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
